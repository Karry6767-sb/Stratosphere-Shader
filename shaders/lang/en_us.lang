option.AO_TYPE=AO Mode
option.AO_TYPE.comment=0=Off (use vanilla vertex AO); 1=SSAO (screen space, fewer samples, faster); 2=GTAO (horizon-based integration, more accurate). Both use a moderate quality tier.
option.AO_STRENGTH=AO Strength
option.AO_STRENGTH.comment=How strongly occlusion darkens indirect light. 1.0 is standard; >1 darker, <1 lighter.
option.AO_RADIUS=AO Radius
option.AO_RADIUS.comment=Sample radius in world units. Larger covers more (corners, under trees).
option.AO_SAMPLES=AO Sampling Budget
option.AO_SAMPLES.comment=AO sampling budget. 4=cheap, 8=default, 12/16=finer but costlier.
option.CONTACT_SHADOW=Screen-Space Contact Shadows
option.CONTACT_SHADOW.comment=Marches along the light direction in screen space to recover near shadows that the shadow map resolution cannot resolve. Greatly improves grass, leaves and vines. Costs a few extra depth samples per pixel; keep off on low-end GPUs.
value.CONTACT_SHADOW.0=Off
value.CONTACT_SHADOW.1=On
option.CONTACT_SHADOW_SAMPLES=Contact Shadow Steps
option.CONTACT_SHADOW_SAMPLES.comment=Number of march steps. More is finer but slower. 10 is a good middle ground.
option.CONTACT_SHADOW_LENGTH=Contact Shadow Distance
option.CONTACT_SHADOW_LENGTH.comment=Ray length along the light direction (world units). Longer reaches further but loses precision.
option.TAA=Temporal Anti-Aliasing
value.TAA.0=Off
value.TAA.1=On
option.TAA_STRENGTH=TAA History Strength
option.FXAA_ENABLED=FXAA Spatial AA
value.FXAA_ENABLED.0=Off
value.FXAA_ENABLED.1=On
option.FXAA_QUALITY=FXAA Strength
option.BRIGHTNESS=Brightness
option.CONTRAST=Contrast
option.SATURATION=Saturation
option.GAIN_B=Blue Channel Gain
option.GAIN_B.comment=Full-screen blue gain. KEEP AT 1.0: any global cast eats the sky's blue directly (measured: GAIN_B=0.80 drops a clear-sky blue channel from 0.726 to 0.514, about -29%), leaving the zenith grey-yellow and clouds shapeless.
option.COLOR_OFFSET=Split-Tone Strength
option.TM_HIGHLIGHT_KNEE=Highlight Knee
option.TM_HIGHLIGHT_KNEE.comment=Brightness above this value starts to be compressed. 1.0 = the post-exposure white point; ground normally sits below it, so this never darkens the ground.
option.TM_HIGHLIGHT_COMPRESS=Highlight Compression
option.TM_HIGHLIGHT_COMPRESS.comment=How hard the sky is compressed. 0 = off (sky may blow out); higher darkens sky/sun while keeping the gradient, so clouds and glow do not flatten.
option.COLOR_OFFSET.comment=Warm highlights and slightly cool shadows. The neutral grade keeps only 0.25 as a light finishing touch; 0 is strictly neutral.
option.SSIL_ENABLE=Screen-Space Indirect Lighting
value.SSIL_ENABLE.0=Off
value.SSIL_ENABLE.1=On
option.SSIL_SAMPLES=SSIL Samples
option.SSIL_RADIUS=SSIL Radius
option.SSIL_STEPS=SSIL Ray Steps
option.SSIL_STEPS.comment=Screen-space steps per hemisphere ray. More = more accurate, more expensive.
option.SSIL_THICKNESS=SSIL Hit Thickness
option.SSIL_THICKNESS.comment=Depth tolerance for accepting a ray hit (world units). Too small leaks, too large over-hits.
option.SSIL_INTENSITY=SSIL Intensity
option.SSIL_TEMPORAL_ENABLE=SSIL Temporal Denoising
option.SSIL_TEMPORAL_ENABLE.comment=Uses the previous frame history to suppress the flicker of 32-ray SSIL. Off falls back to the raw S5 result (noisier, but never ghosts).
value.SSIL_TEMPORAL_ENABLE.0=Off
value.SSIL_TEMPORAL_ENABLE.1=On
option.SSIL_TEMPORAL_ALPHA=SSIL Temporal Alpha
option.SSIL_TEMPORAL_ALPHA.comment=Current-frame weight. Lower = smoother but more ghosting under fast motion; 0.10 is the recommended value.
option.SSR_ENABLE=Screen-Space Reflections (SSR)
option.SSR_ENABLE.comment=Mirrors the already-lit on-screen scene on metal, smooth stone/quartz and gems. Water keeps its own dedicated SSR path.
value.SSR_ENABLE.0=Off
value.SSR_ENABLE.1=On
option.SSR_MAX_STEPS=SSR March Steps
option.SSR_MAX_STEPS.comment=Screen-space steps per reflection ray. More = more accurate, more expensive.
option.SSR_REFINE_STEPS=SSR Refinement Steps
option.SSR_REFINE_STEPS.comment=Bisection steps after a hit; aligns the reflected content to sub-pixel accuracy.
option.SSR_RAY_COUNT=SSR Max Rays
option.SSR_RAY_COUNT.comment=Upper bound for cone-filtered rays on rough surfaces; smoother materials automatically use fewer.
option.SSR_DISTANCE=SSR Distance
option.SSR_DISTANCE.comment=Maximum reflection ray length in world units. Longer reaches further but loses step precision.
option.SSR_THICKNESS=SSR Hit Thickness
option.SSR_THICKNESS.comment=Depth tolerance for accepting a reflection hit (world units). Too small misses, too large sticks to the wrong surface.
option.SSR_INTENSITY=SSR Intensity
option.SSR_INTENSITY.comment=Multiplier for the screen-space reflection contribution.
option.EXPOSURE_ENABLED=Auto Exposure
value.EXPOSURE_ENABLED.0=Off (manual EV only)
value.EXPOSURE_ENABLED.1=On (histogram metering)
option.EXPOSURE_MODE=Exposure Mode
value.EXPOSURE_MODE.0=Manual EV
value.EXPOSURE_MODE.1=Auto Basic
value.EXPOSURE_MODE.2=Auto Histogram
option.EXPOSURE_KEY_VALUE=Key-Value Exposure
value.EXPOSURE_KEY_VALUE.0=Legacy percentile
value.EXPOSURE_KEY_VALUE.1=Reinhard key-value
option.EXPOSURE_NIGHT_KEY=Night Target Key
option.SCOTOPIC_STRENGTH=Scotopic (Purkinje)
option.SCOTOPIC_THRESHOLD=Scotopic Threshold
option.EXPOSURE_SKY_WEIGHT_NIGHT=Night Sky Metering
option.EXPOSURE_AMBIENT_FLOOR=Ambient Adaptation Floor
option.EXPOSURE_NIGHT_AMBIENT=Night Ambient Threshold
option.MANUAL_EV=Manual EV
option.MANUAL_EV.comment=Camera-style manual exposure: output = exp2(-MANUAL_EV). Larger values are darker.
option.AUTO_EV_MIN=Auto EV Min
option.AUTO_EV_MIN.comment=Maximum brightening allowed. More negative = brighter nights. Must be >= the gap between the scene's night luminance and mid-grey, otherwise metering is clamped and nights are systematically crushed.
option.AUTO_EV_MAX=Auto EV Max
option.AUTO_EV_BIAS=Auto EV Bias
option.AUTO_EV_BIAS.comment=Positive brightens, negative darkens. Default +0.25 EV (about +19%) so looking up at the sky does not crush the ground.
option.EXPOSURE_SKY_WEIGHT=Sky Metering Weight
option.EXPOSURE_SKY_WEIGHT.comment=How much sky pixels count in auto-exposure. 0 = meter the ground only (brightness barely changes when you look up); 1 = sky counts equally (looking up darkens the scene a lot).
option.EXPOSURE_HIGHLIGHT_EV=Highlight Metering Limit
option.EXPOSURE_HIGHLIGHT_EV.comment=Pixels brighter than 0.18*2^this are ignored by metering, so sun, explosions and glowing blocks cannot drag the exposure. 99 = no clipping.
option.HISTOGRAM_LOWER=Histogram Lower
option.HISTOGRAM_UPPER=Histogram Upper
option.EXPOSURE_SPEED_UP=Exposure Brighten Speed
option.EXPOSURE_SPEED_DOWN=Exposure Darken Speed
option.BLOOM_INTENSITY=Bloom Intensity
option.BLOOM_THRESHOLD=Bloom Threshold
option.BLOOM_MIP_CHAIN=Bloom Mip Pyramid
value.BLOOM_MIP_CHAIN.0=Single-scale fallback
value.BLOOM_MIP_CHAIN.1=New mip chain
option.BLOOM_CHROMA=Chromatic Bloom
option.BLOOM_CHROMA.comment=Real lenses refract R/G/B at slightly different radii, so bright edges get warm/cool fringes. The offset is a few thousandths of the screen radius, so the halo never moves.
value.BLOOM_CHROMA.0=Off
value.BLOOM_CHROMA.1=On
option.BLOOM_CHROMA_AMOUNT=Chromatic Amount
option.BLOOM_CHROMA_AMOUNT.comment=Thousandths of the screen radius. Larger = more visible fringing; too large looks like purple fringing.
option.BLOOM_STREAK=Anamorphic Streak
option.BLOOM_STREAK.comment=Horizontal lens streak around the sun/moon. Only bloom above the threshold streaks, so the image is not smeared sideways.
option.BLOOM_STREAK_REACH=Streak Length
option.BLOOM_STREAK_REACH.comment=Half length of the streak in pixels. Longer looks more cinematic.

option.VIGNETTE_STRENGTH=Vignette Strength
option.VIGNETTE_STRENGTH.comment=Cinematic darkening towards the screen edges. 0 = off, higher = stronger.
option.VIGNETTE_TYPE=Vignette Type
option.VIGNETTE_TYPE.comment=0 = linear (the old 1-k*r^2 point sample; slight banding is visible at the edge). 1 = integrated (optical cos^4 falloff averaged over each pixel's footprint; smooth and resolution-independent).
value.VIGNETTE_TYPE.0=Linear
value.VIGNETTE_TYPE.1=Integrated
option.VIGNETTE_FOV=Vignette FOV
option.VIGNETTE_FOV.comment=The integrated vignette needs the off-axis angle at the screen edge; set it to the vertical FOV you actually use. It only shapes the falloff distribution and never brightens or darkens the whole image.
option.CINE_INTRO=Opening Intro
value.CINE_INTRO.0=Off
value.CINE_INTRO.1=On
option.CINE_INTRO.comment=Play a 5-second cinematic intro when the shader loads: black fade -> letterbox -> logo -> shader name -> author -> fade out. 0=off.
option.CINE_INTRO_DURATION=Intro Duration
option.CINE_INTRO_DURATION.comment=Total intro length in seconds. Default 5.
option.CINE_LETTERBOX=Persistent Letterbox
value.CINE_LETTERBOX.0=Off
value.CINE_LETTERBOX.1=On
option.CINE_LETTERBOX.comment=Keep permanent black bars at the top and bottom for a widescreen look. 1=on, 0=off.
option.CINE_LETTERBOX_SIZE=Letterbox Height
option.CINE_LETTERBOX_SIZE.comment=Bar height as a fraction of screen height. 0.10 means about 10% on each side.
option.CINE_VIGNETTE=Cinematic Vignette
option.CINE_VIGNETTE.comment=Adds an extra lens-like vignette on top of the regular one. 0=off.
option.CINE_VIGNETTE_ANAMORPHIC=Anamorphic Vignette
value.CINE_VIGNETTE_ANAMORPHIC.0=Radial
value.CINE_VIGNETTE_ANAMORPHIC.1=Anamorphic
option.CINE_VIGNETTE_ANAMORPHIC.comment=1=horizontally wider vignette (widescreen lens look); 0=normal radial vignette.
option.CINE_GRAIN=Film Grain
option.CINE_GRAIN.comment=Adds film grain, stronger in shadows, for an analog look. 0=off.
option.CINE_GRAIN_SIZE=Grain Size
option.CINE_GRAIN_SIZE.comment=Pixel size of the grain. Larger is coarser.
option.CINE_CHROMA=Chromatic Aberration
option.CINE_CHROMA.comment=Shifts RGB channels apart near the edges for a lens color-fringe look. 0=off.
option.CINE_HALATION=Highlight Halation
option.CINE_HALATION.comment=Warm glow bleeding out of highlights, mimicking film halation. 0=off.
option.CINE_BARREL=Barrel Distortion
option.CINE_BARREL.comment=Slight spherical lens distortion. 0=off.
option.BB_FIRE_TEMP=Fire Temp
option.BB_SUN_TEMP=Sun Temp
option.BB_MOON_TEMP=Moon Temp
screen.EDGE_FOG=Edge Fog
option.ENABLE_EDGE_FOG=Edge Fog
option.ENABLE_EDGE_FOG.comment=Render-distance edge fog: distant geometry fades to horizon sky color.
value.ENABLE_EDGE_FOG.0=Off
value.ENABLE_EDGE_FOG.1=On
option.EDGE_FOG_STRENGTH=Edge Fog Strength
screen.CLOUDS=Clouds
option.ENABLE_CLOUDS=Volumetric Clouds
option.ENABLE_CLOUDS.comment=Volumetric low/mid cloud layer: cloudmap-driven shape plus spherical-shell raymarching.
value.ENABLE_CLOUDS.0=Off
value.ENABLE_CLOUDS.1=On
option.ENABLE_HIGH_CLOUDS=High Clouds
option.ENABLE_HIGH_CLOUDS.comment=Toggle Ci/Cs/Cc high cirrus separately for isolation testing.
value.ENABLE_HIGH_CLOUDS.0=Off
value.ENABLE_HIGH_CLOUDS.1=On
option.CLOUD_COVERAGE=Cloud Coverage
option.CLOUD_COVERAGE.comment=Fraction of the sky covered by cloud. Higher = larger overcast regions.
option.CLOUD_DENSITY=Cloud Density
option.CLOUD_DENSITY.comment=Optical thickness multiplier. Higher = more opaque, darker cloud base.
option.CLOUD_THICKNESS=Cloud Layer Thickness
option.CLOUD_THICKNESS.comment=Cloud shell thickness in blocks (meters): 600 = thin stratocumulus, 4500 = cumulus deck, 8000 = deep convective layer.
option.CLOUD_SAMPLES=Cloud Steps
option.CLOUD_SAMPLES.comment=Maximum raymarch steps per ray. Higher = finer detail, lower performance.
option.ENABLE_CLOUD_SHADOWS=Cloud Shadows
option.ENABLE_CLOUD_SHADOWS.comment=Independent cloud-shadow map: moving cloud shadows on terrain, water bottoms and underwater fog.
value.ENABLE_CLOUD_SHADOWS.0=Off
value.ENABLE_CLOUD_SHADOWS.1=On
option.CLOUD_SHADOW_DISTANCE=Cloud Shadow Range
option.CLOUD_SHADOW_DISTANCE.comment=World-space size of the cloud-shadow map (blocks). Larger covers more terrain but softens detail.
option.CLOUD_SHADOW_SAMPLES=Cloud Shadow Steps
option.CLOUD_SHADOW_SAMPLES.comment=Light-march steps used to bake the cloud-shadow map.
option.CLOUD_SHADOW_STRENGTH=Cloud Shadow Strength
option.CLOUD_SHADOW_STRENGTH.comment=How dark fully clouded shadow rays become.
option.ENABLE_CLOUD_TEMPORAL=Cloud Temporal Filter
option.ENABLE_CLOUD_TEMPORAL.comment=Temporal reprojection and history accumulation for volumetric clouds.
value.ENABLE_CLOUD_TEMPORAL.0=Off
value.ENABLE_CLOUD_TEMPORAL.1=On
option.CLOUD_TEMPORAL_BLEND=Temporal Blend
option.CLOUD_TEMPORAL_BLEND.comment=Current-frame weight in the cloud history blend. Higher = less ghosting, more noise.
screen.ATMOSPHERE=Atmosphere
screen.ATMOSPHERE_SCATTER=Atmosphere Scattering
